# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# The Gmail address you send from.
GMAIL_ADDRESS=you@gmail.com

# A Google "App Password" (16 chars, no spaces), NOT your normal password.
# Create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Display name shown to recipients.
SENDER_NAME=Your Shop Name

# Optional: address customer replies go to (defaults to GMAIL_ADDRESS).
REPLY_TO=support@yourshop.com
